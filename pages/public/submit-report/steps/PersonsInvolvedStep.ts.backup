import {
  expect,
  Locator,
  Page
} from '@playwright/test';

import {
  InvolvedPerson,
  PersonInvolvedData
} from '../../../../models/public/PersonInvolvedData';


export class PersonsInvolvedStep {

  constructor(
    private readonly page: Page
  ) { }


  // ============================================================
  // CORE LOCATORS
  // ============================================================

  private heading(): Locator {
    return this.page.getByRole(
      'heading',
      {
        name: 'Person(s) Involved',
        level: 2
      }
    );
  }


  private yesRadio(): Locator {
    return this.page.getByRole(
      'radio',
      {
        name: 'Yes',
        exact: true
      }
    );
  }


  private noRadio(): Locator {
    return this.page.getByRole(
      'radio',
      {
        name: 'No',
        exact: true
      }
    );
  }


  private table(): Locator {
    return this.page.getByRole('table');
  }


  private nextButton(): Locator {
    return this.page.getByRole(
      'button',
      {
        name: 'Next',
        exact: true
      }
    );
  }


  private backButton(): Locator {
    return this.page.getByRole(
      'button',
      {
        name: 'Back',
        exact: true
      }
    );
  }


  // ============================================================
  // ADD PERSON ACTION
  //
  // DOM discovery confirmed:
  // <button>Person(s) Involved</button>
  //
  // Visually this is:
  // + Person(s) Involved
  // ============================================================

  private addPersonButton(): Locator {
    return this.page.getByRole(
      'button',
      {
        name: 'Person(s) Involved',
        exact: true
      }
    );
  }


  // ============================================================
  // PAGE VERIFICATION
  // ============================================================

  async verifyLoaded(): Promise<void> {

    await expect(
      this.heading()
    ).toBeVisible();

    await expect(
      this.yesRadio()
    ).toBeVisible();

    await expect(
      this.noRadio()
    ).toBeVisible();

    await expect(
      this.nextButton()
    ).toBeVisible();

    await expect(
      this.backButton()
    ).toBeVisible();
  }


  // ============================================================
  // CAN IDENTIFY
  // ============================================================

  async selectCanIdentify(
    answer: PersonInvolvedData['canIdentify']
  ): Promise<void> {

    const radio =
      answer === 'Yes'
        ? this.yesRadio()
        : this.noRadio();

    await expect(
      radio
    ).toBeVisible();

    await expect(
      radio
    ).toBeEnabled();

    await radio.check();

    await expect(
      radio
    ).toBeChecked();


    // When Yes is selected, the person table should be displayed.
    if (
      answer === 'Yes'
    ) {

      await expect(
        this.table()
      ).toBeVisible();
    }
  }


  // ============================================================
  // PERSON COUNT
  //
  // Table structure:
  //
  // row 0 = header
  // row 1 = person 1
  // row 2 = person 2
  // ...
  // ============================================================

  async getPersonCount(): Promise<number> {

    const table =
      this.table();

    if (
      !(await table.isVisible())
    ) {
      return 0;
    }


    const rows =
      table.getByRole('row');

    const rowCount =
      await rows.count();


    return Math.max(
      rowCount - 1,
      0
    );
  }


  // ============================================================
  // GET PERSON ROW
  // ============================================================

  private async getPersonRow(
    personIndex: number
  ): Promise<Locator> {

    const table =
      this.table();

    await expect(
      table
    ).toBeVisible();


    const rows =
      table.getByRole('row');

    const personCount =
      Math.max(
        (await rows.count()) - 1,
        0
      );


    if (
      personIndex < 0 ||
      personIndex >= personCount
    ) {

      throw new Error(
        `Person row ${personIndex + 1} is not available. ` +
        `Current person count: ${personCount}.`
      );
    }


    const row =
      rows.nth(
        personIndex + 1
      );

    await expect(
      row
    ).toBeVisible();

    return row;
  }


  // ============================================================
  // FIELD LOCATORS
  // ============================================================

  private fullNameField(
    row: Locator,
    rowNumber: number
  ): Locator {

    return row.getByRole(
      'textbox',
      {
        name: `Full Name ${rowNumber}`,
        exact: true
      }
    );
  }


  private positionField(
    row: Locator,
    rowNumber: number
  ): Locator {

    return row.getByRole(
      'textbox',
      {
        name: `Position ${rowNumber}`,
        exact: true
      }
    );
  }


  private companyField(
    row: Locator,
    rowNumber: number
  ): Locator {

    return row.getByRole(
      'textbox',
      {
        name: `Company ${rowNumber}`,
        exact: true
      }
    );
  }


  private departmentField(
    row: Locator,
    rowNumber: number
  ): Locator {

    return row.getByRole(
      'textbox',
      {
        name: `Department ${rowNumber}`,
        exact: true
      }
    );
  }


  private emailField(
    row: Locator,
    rowNumber: number
  ): Locator {

    return row.getByRole(
      'textbox',
      {
        name: `Email ${rowNumber}`,
        exact: true
      }
    );
  }


  private phoneField(
    row: Locator,
    rowNumber: number
  ): Locator {

    return row.getByRole(
      'textbox',
      {
        name: `Phone ${rowNumber}`,
        exact: true
      }
    );
  }


  private roleInIncidentField(
    row: Locator,
    rowNumber: number
  ): Locator {

    return row.getByRole(
      'combobox',
      {
        name: `Role In Incident ${rowNumber}`,
        exact: true
      }
    );
  }


  // ============================================================
  // FILL PERSON
  //
  // Current UI:
  //
  // Full Name*       -> textbox
  // Position*        -> textbox
  // Company*         -> textbox
  // Department       -> textbox
  // Email            -> textbox
  // Phone            -> textbox
  // Role In Incident -> select / combobox
  //
  // Role values:
  // Accused
  // Victim
  // ============================================================

  async fillPerson(
    personIndex: number,
    person: InvolvedPerson
  ): Promise<void> {

    const row =
      await this.getPersonRow(
        personIndex
      );

    const rowNumber =
      personIndex + 1;


    // ----------------------------------------------------------
    // Full Name
    // ----------------------------------------------------------

    const fullName =
      this.fullNameField(
        row,
        rowNumber
      );

    await expect(
      fullName
    ).toBeVisible();

    await fullName.fill(
      person.fullName
    );


    // ----------------------------------------------------------
    // Position
    // ----------------------------------------------------------

    const position =
      this.positionField(
        row,
        rowNumber
      );

    await expect(
      position
    ).toBeVisible();

    await position.fill(
      person.position
    );


    // ----------------------------------------------------------
    // Company
    // ----------------------------------------------------------

    const company =
      this.companyField(
        row,
        rowNumber
      );

    await expect(
      company
    ).toBeVisible();

    await company.fill(
      person.company
    );


    // ----------------------------------------------------------
    // Department
    // ----------------------------------------------------------

    if (
      person.department !== undefined
    ) {

      const department =
        this.departmentField(
          row,
          rowNumber
        );

      await expect(
        department
      ).toBeVisible();

      await department.fill(
        person.department
      );
    }


    // ----------------------------------------------------------
    // Email
    // ----------------------------------------------------------

    if (
      person.email !== undefined
    ) {

      const email =
        this.emailField(
          row,
          rowNumber
        );

      await expect(
        email
      ).toBeVisible();

      await email.fill(
        person.email
      );
    }


    // ----------------------------------------------------------
    // Phone
    // ----------------------------------------------------------

    if (
      person.phone !== undefined
    ) {

      const phone =
        this.phoneField(
          row,
          rowNumber
        );

      await expect(
        phone
      ).toBeVisible();

      await phone.fill(
        person.phone
      );
    }


    // ----------------------------------------------------------
    // Role In Incident
    //
    // IMPORTANT:
    // This is SELECT, not textbox.
    // ----------------------------------------------------------

    if (
      person.roleInIncident !== undefined
    ) {

      const role =
        this.roleInIncidentField(
          row,
          rowNumber
        );

      await expect(
        role
      ).toBeVisible();

      await expect(
        role
      ).toBeEnabled();

      await role.selectOption({
        label: person.roleInIncident
      });

      await expect(
        role
      ).toHaveValue(
        person.roleInIncident
      );
    }
  }


  // ============================================================
  // ADD PERSON
  //
  // Visual UI:
  // + Person(s) Involved
  //
  // Accessible button name discovered:
  // Person(s) Involved
  // ============================================================

  async addPerson(): Promise<void> {

    const countBefore =
      await this.getPersonCount();

    const button =
      this.addPersonButton();

    await expect(
      button
    ).toBeVisible();

    await expect(
      button
    ).toBeEnabled();

    await button.click();


    // ----------------------------------------------------------
    // Verify new row was created.
    // ----------------------------------------------------------

    await expect
      .poll(
        async () =>
          this.getPersonCount(),
        {
          message:
            'Expected a new Person(s) Involved row to be added.'
        }
      )
      .toBe(
        countBefore + 1
      );


    // ----------------------------------------------------------
    // Verify new row is usable.
    // ----------------------------------------------------------

    const newRow =
      await this.getPersonRow(
        countBefore
      );

    await expect(
      this.fullNameField(
        newRow,
        countBefore + 1
      )
    ).toBeVisible();
  }


  // ============================================================
  // REMOVE PERSON
  //
  // UI:
  // Additional rows expose an X/remove action in final column.
  // ============================================================

  async removePerson(
    personIndex: number
  ): Promise<void> {

    const countBefore =
      await this.getPersonCount();


    if (
      countBefore <= 1
    ) {

      throw new Error(
        'Cannot remove Person because only one person row currently exists.'
      );
    }


    if (
      personIndex < 0 ||
      personIndex >= countBefore
    ) {

      throw new Error(
        `Invalid person index ${personIndex}. ` +
        `Current person count: ${countBefore}.`
      );
    }


    const row =
      await this.getPersonRow(
        personIndex
      );


    // ----------------------------------------------------------
    // Last table cell contains the remove action.
    // ----------------------------------------------------------

    const actionCell =
      row.locator('td').last();


    // ----------------------------------------------------------
    // Strategy 1:
    // Native button
    // ----------------------------------------------------------

    const nativeButton =
      actionCell.locator('button');


    if (
      await nativeButton.count() > 0
    ) {

      await expect(
        nativeButton.first()
      ).toBeVisible();

      await nativeButton.first().click();

    } else {

      // --------------------------------------------------------
      // Strategy 2:
      // Element with button role
      // --------------------------------------------------------

      const roleButton =
        actionCell.locator(
          '[role="button"]'
        );


      if (
        await roleButton.count() > 0
      ) {

        await expect(
          roleButton.first()
        ).toBeVisible();

        await roleButton.first().click();

      } else {

        // ------------------------------------------------------
        // Strategy 3:
        // Accessible label/title containing remove/delete
        // ------------------------------------------------------

        const accessibleRemove =
          actionCell.locator(
            '[aria-label*="remove" i], ' +
            '[aria-label*="delete" i], ' +
            '[title*="remove" i], ' +
            '[title*="delete" i]'
          );


        if (
          await accessibleRemove.count() > 0
        ) {

          await expect(
            accessibleRemove.first()
          ).toBeVisible();

          await accessibleRemove.first().click();

        } else {

          // ----------------------------------------------------
          // Strategy 4:
          // Current visual implementation may expose only an
          // icon/SVG for the X action.
          // ----------------------------------------------------

          const svg =
            actionCell.locator('svg');


          if (
            await svg.count() > 0
          ) {

            const clickableParent =
              svg.first().locator('..');

            await expect(
              clickableParent
            ).toBeVisible();

            await clickableParent.click();

          } else {

            throw new Error(
              `Unable to locate Remove Person action ` +
              `for person row ${personIndex + 1}.`
            );
          }
        }
      }
    }


    // ----------------------------------------------------------
    // Verify removal really happened.
    // ----------------------------------------------------------

    await expect
      .poll(
        async () =>
          this.getPersonCount(),
        {
          message:
            `Expected Person row ${personIndex + 1} to be removed.`
        }
      )
      .toBe(
        countBefore - 1
      );
  }


  // ============================================================
  // FILL STEP
  // ============================================================

  async fill(
    data: PersonInvolvedData
  ): Promise<void> {

    await this.verifyLoaded();

    await this.selectCanIdentify(
      data.canIdentify
    );


    // ----------------------------------------------------------
    // NO
    // ----------------------------------------------------------

    if (
      data.canIdentify === 'No'
    ) {
      return;
    }


    // ----------------------------------------------------------
    // YES
    // ----------------------------------------------------------

    const persons =
      data.persons ?? [];


    // ----------------------------------------------------------
    // Allows negative validation:
    //
    // Yes selected
    // first row remains empty
    // test clicks Next
    // validation should prevent navigation
    // ----------------------------------------------------------

    if (
      persons.length === 0
    ) {
      return;
    }


    // ----------------------------------------------------------
    // First row already exists.
    //
    // For every additional person:
    // click + Person(s) Involved first.
    // ----------------------------------------------------------

    for (
      let index = 0;
      index < persons.length;
      index++
    ) {

      if (
        index > 0
      ) {

        await this.addPerson();
      }


      await this.fillPerson(
        index,
        persons[index]
      );
    }
  }


  // ============================================================
  // NEXT
  // ============================================================

  async next(): Promise<void> {

    const button =
      this.nextButton();

    await expect(
      button
    ).toBeVisible();

    await expect(
      button
    ).toBeEnabled();

    await button.click();
  }


  // ============================================================
  // BACK
  // ============================================================

  async back(): Promise<void> {

    const button =
      this.backButton();

    await expect(
      button
    ).toBeVisible();

    await expect(
      button
    ).toBeEnabled();

    await button.click();
  }
}